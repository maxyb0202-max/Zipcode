{
  "name": "codebox",
  "version": "1.4.0",
  "description": "Super simple IDE for Python, Java, C and C++",
  "main": "main.js",
  "author": "Max",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64 --publish never",
    "release": "electron-builder --win nsis --x64 --publish always"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "electron-updater": "^6.8.11",
    "monaco-editor": "^0.52.2"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.codebox.ide",
    "productName": "CodeBox",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "build/icon.png",
      "!node_modules/monaco-editor/esm/**",
      "!node_modules/monaco-editor/dev/**",
      "!node_modules/monaco-editor/min-maps/**",
      "!node_modules/@xterm/xterm/src/**",
      "!**/*.map",
      "!**/*.ts"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png",
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CodeBox",
      "artifactName": "CodeBox-Setup.exe",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "maxyb0202-max",
        "repo": "codebox",
        "releaseType": "release"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/maxyb0202-max/codebox.git"
  }
}
